# Root .env for `docker compose up` (copy to .env and change every secret).
POSTGRES_PASSWORD=change-me-local-only
AUTOMIND_JWT_SECRET=change-me-to-64-random-bytes
# base64 of 32 random bytes:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
AUTOMIND_DATA_ENCRYPTION_KEY=
AUTOMIND_BLIND_INDEX_KEY=
# Optional: AI narrative layer (Claude). Leave empty to use rule-based diagnosis only.
ANTHROPIC_API_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
