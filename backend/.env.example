# AutoMind AI API — environment variables (prefix AUTOMIND_). Copy to backend/.env for local runs.
# NEVER commit real secrets. In prod the API refuses to start while any secret below has its dev default.

# ---- runtime ------------------------------------------------------------------
# dev | test | prod  (prod: no /docs, HSTS header, secret checks enforced)
AUTOMIND_ENVIRONMENT=dev
AUTOMIND_LOG_LEVEL=INFO
AUTOMIND_LOG_JSON=true

# ---- database (PostgreSQL / Supabase) ------------------------------------------
# Connect as the schema owner (the role that ran supabase/migrations). Per request the API
# switches to the RLS role below with `set local role`; register/login/workers run as the owner.
AUTOMIND_DATABASE_URL=postgresql+asyncpg://automind_owner:CHANGE_ME@localhost:5432/automind
# NOLOGIN role created by the migrations; every user request runs as this role under RLS.
AUTOMIND_DB_APP_ROLE=automind_app
AUTOMIND_DB_POOL_SIZE=10
AUTOMIND_DB_MAX_OVERFLOW=10
# true = no pooling (serverless / tests). With Supabase's transaction pooler (pgbouncer, port 6543)
# prefer the session pooler or a direct connection: asyncpg prepared statements need session mode.
AUTOMIND_DB_NULL_POOL=false
# Create next months' telemetry partitions at start-up (idempotent).
AUTOMIND_DB_ENSURE_PARTITIONS_ON_STARTUP=true

# ---- redis (optional) ------------------------------------------------------------
# Shared sliding-window rate limiter. Empty = in-memory limiter (single process only).
AUTOMIND_REDIS_URL=

# ---- tokens ---------------------------------------------------------------------
# HS256 secret, >= 32 random chars:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTOMIND_JWT_SECRET=CHANGE_ME
# HS256 | HS384 | HS512 | RS256 | ES256 (RS/ES need the PEM keys below)
AUTOMIND_JWT_ALGORITHM=HS256
AUTOMIND_JWT_PRIVATE_KEY=
AUTOMIND_JWT_PUBLIC_KEY=
# "iss" / "aud" put into and required on every access token (tokens from other systems are rejected)
AUTOMIND_JWT_ISSUER=automind-api
AUTOMIND_JWT_AUDIENCE=automind-api
# access token lifetime (s) and opaque refresh token lifetime (s, rotated on every use)
AUTOMIND_ACCESS_TOKEN_TTL_S=900
AUTOMIND_REFRESH_TOKEN_TTL_S=2592000

# ---- application-layer encryption ---------------------------------------------------
# base64 of exactly 32 random bytes:  python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# AES-256-GCM key for VIN, plate number and MFA secrets (keep outside the database; rotate via blob version byte).
AUTOMIND_DATA_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
# HMAC-SHA256 key for the VIN blind index (must differ from the encryption key; changing it breaks lookups).
AUTOMIND_BLIND_INDEX_KEY=CHANGE_ME_BASE64_32_BYTES

# ---- passwords & lockout ---------------------------------------------------------------
# Argon2id parameters (changing them re-hashes passwords transparently at next login).
AUTOMIND_ARGON2_TIME_COST=3
AUTOMIND_ARGON2_MEMORY_KIB=65536
AUTOMIND_ARGON2_PARALLELISM=4
AUTOMIND_LOCKOUT_THRESHOLD=5
AUTOMIND_LOCKOUT_MINUTES=15

# ---- HTTP -------------------------------------------------------------------------------
# Comma-separated browser origins allowed by CORS (the admin dashboard). Empty = CORS disabled.
AUTOMIND_CORS_ORIGINS=http://localhost:3000
# Honour X-Forwarded-For for the client IP (rate limits, audit). Only behind a trusted proxy!
AUTOMIND_TRUST_PROXY_HEADERS=false
# Number of proxies in front of the API that each append to X-Forwarded-For (load balancer = 1,
# load balancer + CDN = 2). The client IP is read that many entries from the right; entries further
# left are client-supplied and ignored, so rotating them cannot dodge per-IP rate limits.
AUTOMIND_TRUSTED_PROXY_COUNT=1

# ---- rate limits (requests per minute) -----------------------------------------------------
AUTOMIND_RATE_LIMIT_ENABLED=true
AUTOMIND_RATE_LIMIT_AUTH_PER_MIN=10
AUTOMIND_RATE_LIMIT_USER_PER_MIN=120

# ---- recordings -----------------------------------------------------------------------------
# Recordings at or above this size return 413 until object storage is wired up.
AUTOMIND_MAX_INLINE_RECORDING_BYTES=1000000

# ---- demo (server-side ECU simulator) ----------------------------------------------------------
# Simulated-time compression for /demo/run. Empty = automatic (a run takes at most ~12 s).
AUTOMIND_DEMO_TIME_SCALE=

# ---- LLM narrative (optional) ------------------------------------------------------------------
# Without a key, use_llm=true silently falls back to the rule-based result (engine = 'rules').
AUTOMIND_ANTHROPIC_API_KEY=
AUTOMIND_LLM_MODEL=claude-opus-5-5

# ---- fault-code explanations (POST /kb/explain) --------------------------------------------------
# LLM that words the explanation: anthropic | ollama | none. Empty = anthropic when
# AUTOMIND_ANTHROPIC_API_KEY is set, otherwise none (KB-only answers, source = "kb").
# Any provider error or timeout also falls back to the KB answer (never a 500).
AUTOMIND_LLM_PROVIDER=
# Local/self-hosted Ollama (server config only — never taken from a request). POSTs to {url}/api/chat.
AUTOMIND_OLLAMA_URL=http://localhost:11434
AUTOMIND_OLLAMA_MODEL=llama3.1
# Timeout (seconds) for each provider call (LLM, YouTube).
AUTOMIND_EXPLAIN_TIMEOUT_S=20
# Explanations are cached per (code, make, model, year, lang) — in Redis when AUTOMIND_REDIS_URL is set,
# otherwise in-process. KB fallbacks caused by a provider failure are cached for at most 5 minutes.
AUTOMIND_EXPLAIN_CACHE_TTL_S=604800
# YouTube Data API v3 key for video suggestions (search, safeSearch=strict). Empty = videos: [].
AUTOMIND_YOUTUBE_API_KEY=
