# Public base URL of the AutoMind REST API, as seen from the browser.
# Inlined at build time (NEXT_PUBLIC_*), and its origin is added to the CSP connect-src.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Optional: URL the Next.js server uses to reach the API for /api/session
# (login/refresh/logout proxy), e.g. http://backend:8000/api/v1 inside Docker.
# Defaults to NEXT_PUBLIC_API_BASE_URL.
# API_INTERNAL_BASE_URL=

# Optional: force the Secure flag on the refresh-token cookie ("true"/"false").
# Defaults to true when NODE_ENV=production.
# SESSION_COOKIE_SECURE=
