{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automind.ai/schemas/recording.v1.json",
  "title": "AutoMind session recording v1",
  "description": "A captured OBD-II session (raw adapter responses + decoded values) that can be replayed bit-for-bit through the same decoders and diagnosis engine. data_mode records where the data came from; a replay never changes the original data_mode of the recording.",
  "type": "object",
  "required": [
    "format",
    "recording_id",
    "created_at",
    "data_mode",
    "source",
    "duration_ms",
    "signals",
    "samples"
  ],
  "properties": {
    "format": {
      "const": "automind.recording.v1"
    },
    "recording_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "data_mode": {
      "enum": [
        "live",
        "demo"
      ],
      "description": "live = captured from a real vehicle; demo = generated by the simulator. Never relabelled."
    },
    "source": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "elm327_wifi",
            "elm327_ble",
            "elm327_serial",
            "simulator"
          ]
        },
        "adapter_firmware": {
          "type": [
            "string",
            "null"
          ]
        },
        "protocol_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "protocol_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "demo_scenario": {
          "type": [
            "string",
            "null"
          ]
        },
        "app": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "vehicle": {
      "type": "object",
      "properties": {
        "vin": {
          "type": [
            "string",
            "null"
          ],
          "description": "Omitted/redacted unless the user opts in."
        },
        "make": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_year": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "supported_pids": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "ecus": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dtcs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "status"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[PCBU][0-9A-F]{4}$"
          },
          "status": {
            "enum": [
              "stored",
              "pending",
              "permanent"
            ]
          },
          "ecu": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "freeze_frames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dtc": {
            "type": [
              "string",
              "null"
            ]
          },
          "frame": {
            "type": "integer"
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        }
      }
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "pid"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "pid": {
            "type": "string"
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "t_ms",
          "pid",
          "values"
        ],
        "properties": {
          "t_ms": {
            "type": "integer",
            "minimum": 0
          },
          "pid": {
            "type": "string",
            "description": "service + pid, e.g. 010C"
          },
          "ecu": {
            "type": [
              "string",
              "null"
            ]
          },
          "raw": {
            "type": [
              "string",
              "null"
            ],
            "description": "data bytes as hex, e.g. '41 0C 1A F8'"
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "t_ms",
          "type"
        ],
        "properties": {
          "t_ms": {
            "type": "integer"
          },
          "type": {
            "enum": [
              "connection_lost",
              "reconnected",
              "ecu_no_response",
              "note"
            ]
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "readiness": {
      "type": [
        "object",
        "null"
      ],
      "description": "Service 01 PID 01 decoded at scan time: mil_on, dtc_count, ignition, monitors {name: {available, complete}}. Used to verify whether a cleared code was re-tested."
    },
    "module_scans": {
      "type": "array",
      "description": "Non-powertrain module reads (airbag/ABS/body/… over UDS). outcome is recorded verbatim; a module that did not answer (no_response) or refused is never recorded as 'no faults', and non-read modules carry no codes.",
      "items": {
        "type": "object",
        "required": [
          "key",
          "name_en",
          "name_ar",
          "outcome"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "name_en": {
            "type": "string"
          },
          "name_ar": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "outcome": {
            "enum": [
              "read_codes",
              "read_no_codes",
              "refused",
              "no_response"
            ]
          },
          "codes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code",
                "status"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[PCBU][0-9A-F]{4}$"
                },
                "status": {
                  "enum": [
                    "stored",
                    "pending",
                    "permanent"
                  ]
                },
                "ecu": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}